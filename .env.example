PORT=3000
NODE_ENV=development

# How many reverse-proxy hops sit in front of this app (default 1).
# Needed so req.ip is the visitor's IP, not the proxy's: location lookup and
# the per-IP lead rate limit both depend on it. Use 2 behind CDN + load
# balancer, 0 if the app is exposed directly.
TRUST_PROXY=1

# Thumbtack API — required for /bath/results.html to return pros.
# Without CLIENT_ID and CLIENT_SECRET the results page shows a token error.
API_BASE_URL=
TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
# Optional: a pre-issued token. Refreshed automatically from the client
# credentials above once it expires.
ACCESS_TOKEN=

# Google Geocoding — resolves GPS coordinates to ZIP/city/state in /api/location.
# Without it, location falls back to IP lookup via ipapi.co.
GOOGLE_GEOCODING_KEY=

# ClickHouse analytics (optional — the app runs without it)
CH_HOST=
CH_PORT=8443
CH_USER=
CH_PASSWORD=
CH_DATABASE=

# PostHog analytics (optional)
POSTHOG_KEY=
