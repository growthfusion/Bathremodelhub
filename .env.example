# ── Thumbtack Partner API ────────────────────────────────────────────────────
# Base URL for Thumbtack API (staging or production)
API_BASE_URL=https://staging-api.thumbtack.com

# OAuth2 token endpoint (auto-derived from API_BASE_URL if blank)
TOKEN_URL=https://staging-auth.thumbtack.com/oauth2/token

# Your Thumbtack Partner API credentials
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Optional: pre-set access token (if you already have one; auto-refreshes otherwise)
ACCESS_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
